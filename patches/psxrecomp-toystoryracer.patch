-void cdrom_savestate_boost_vblank(void) {
-    if (s_savestate_cd_boost_vblanks <= 0) return;
-    cdrom_apply_savestate_delay_caps(/*log_clamps*/0);
-    s_savestate_cd_boost_vblanks--;
