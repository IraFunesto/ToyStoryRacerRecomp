+/* Mod tier: one hook, consulted before the HLE services and the recompiled
+ * BIOS for every A0/B0/C0 kernel call the game makes (function number from
+ * $t1; calls whose $ra is in the BIOS ROM or the kernel's RAM below 0x10000
+ * are the kernel's own and never reach it). It returns
+ * 1 when it did the service itself (results in v0 and guest memory; the guest
+ * resumes at $ra), 0 to let the call through. Installing it installs the
+ * dispatch hook whatever psx_bios_hle_configure() selected; NULL removes it. */
+typedef int (*PsxBiosModCallHook)(struct CPUState* cpu, uint32_t vector,
+                                  uint32_t function);
