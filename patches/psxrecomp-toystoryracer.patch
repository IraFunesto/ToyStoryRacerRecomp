+/* Disc file overrides: a file under "disc_override/" next to the executable
+ * replaces the disc file with the same path (disc_override/COURSE_B/PIER.AXE
+ * -> \COURSE_B\PIER.AXE). It is served from that file's own sectors, so it
+ * must fit in them; the disc's directory keeps the original size. */
+struct DiscOverride {
+    uint32_t lba;
+    uint32_t sectors;
+    std::vector<uint8_t> data;   /* padded to sectors * 2048 */
+};
+std::vector<DiscOverride> g_disc_overrides;
