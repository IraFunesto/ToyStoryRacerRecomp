+    std::string layout = "psxdisc 1\n";
+    layout += "# the disc as extracted files: plain = Mode 2 Form 1 data file (sectors\n"
+              "# rebuilt with header, subheader, EDC, ECC), raw = 2352-byte sectors,\n"
+              "# system = sectors no file owns, raw in disc_system.bin\n";
+    layout += "sectors " + std::to_string(total) + "\n";
+    for (const CDTrack& t : src.tracks_)
+        layout += "track " + std::to_string(t.number) + " " + (t.is_audio ? "1 " : "0 ") +
+                  std::to_string(t.start_lba) + " " + std::to_string(t.pregap_lba) + "\n";
+    for (const auto& q : src.subq_replacements_)
+        layout += "subq " + std::to_string(q.first) + " " + to_hex(q.second.data(), 12) + "\n";
+
+    std::vector<uint8_t> owned(total, 0);
+    std::vector<uint8_t> ecc_records;
+    uint32_t plain_count = 0, raw_count = 0;
+    uint64_t bytes_out = 0;
+    std::vector<uint8_t> sectors, user;
+    uint8_t rebuilt[RAW_SECTOR_SIZE];
+    for (const File& f : files) {
+        sectors.resize(static_cast<size_t>(f.sectors) * RAW_SECTOR_SIZE);
+        for (uint32_t i = 0; i < f.sectors; ++i)
+            if (!src.ReadRawSector(f.lba + i, &sectors[static_cast<size_t>(i) * RAW_SECTOR_SIZE]))
+                return fail("read error at LBA " + std::to_string(f.lba + i));
+        // Plain when every sector is Mode 2 Form 1 and rebuilds exactly from
+        // its subheader and the file's bytes (zero past the end of the file).
+        bool plain = f.size > 0;
+        const uint8_t* sub = &sectors[16];
+        std::string except, ecc_except;
+        int except_count = 0, ecc_count = 0;
+        const size_t ecc_mark = ecc_records.size();
+        user.clear();
+        for (uint32_t i = 0; i < f.sectors && plain; ++i) {
+            const uint8_t* r = &sectors[static_cast<size_t>(i) * RAW_SECTOR_SIZE];
+            if (r[15] != 2 || (r[18] & 0x20u) || std::memcmp(r + 16, r + 20, 4) != 0) {
+                plain = false;
+                break;
+            }
+            if (std::memcmp(r + 16, sub, 4) != 0) {
+                if (++except_count > 64) { plain = false; break; }
+                except += (except.empty() ? "" : ",") + std::to_string(i) + ":" +
+                          to_hex(r + 16, 4);
+            }
+            const uint64_t off = static_cast<uint64_t>(i) * SECTOR_SIZE;
+            const size_t keep = static_cast<size_t>(
+                std::min<uint64_t>(SECTOR_SIZE, f.size > off ? f.size - off : 0));
+            uint8_t data[SECTOR_SIZE] = {};
+            std::memcpy(data, r + RAW_DATA_OFFSET, keep);
+            build_form1_sector(f.lba + i, r + 16, data, rebuilt);
+            if (std::memcmp(rebuilt, r, kEccOffset) != 0) {
+                plain = false;
+                break;
+            }
+            if (std::memcmp(rebuilt + kEccOffset, r + kEccOffset, kEccBytes) != 0) {
+                // a misread sector: its data does not match its EDC/ECC
+                if (++ecc_count > 256) { plain = false; break; }
+                ecc_except += (ecc_except.empty() ? "" : ",") + std::to_string(i) + ":" +
+                              std::to_string(ecc_records.size() / kEccBytes);
+                ecc_records.insert(ecc_records.end(), r + kEccOffset, r + RAW_SECTOR_SIZE);
+            }
+            user.insert(user.end(), data, data + keep);
+        }
+        const fs::path dest = dir / fs::path(f.path);
+        fs::create_directories(dest.parent_path(), ec);
+        std::ofstream out(dest, std::ios::binary | std::ios::trunc);
+        if (plain) {
+            out.write(reinterpret_cast<const char*>(user.data()),
+                      static_cast<std::streamsize>(user.size()));
+            layout += "plain " + std::to_string(f.lba) + " " + std::to_string(f.sectors) + " " +
+                      std::to_string(f.size) + " " + to_hex(sub, 4) + " " +
+                      (except.empty() ? std::string("-") : except) + " " +
+                      (ecc_except.empty() ? std::string("-") : ecc_except) + " " + f.path + "\n";
