-int cdrom_dma_ready(void) {
-    if (request_reg & CDROM_REQUEST_BFRD) ring_note_starved();
-    return (request_reg & CDROM_REQUEST_BFRD) && rb_available() &&
-           (RB_.pos + 4 <= RB_.size);
