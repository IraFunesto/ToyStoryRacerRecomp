-    const CDROMWarmRoute *route = state_index >= 0
-        ? &s_warm_routes[state_index]
-        : (s_warm_routes_count > 0 ? &s_warm_routes[0] : NULL);
-    snprintf(out, (size_t)cap,
-             "\"configured\":%d,\"enabled\":%d,\"armed\":%d,"
-             "\"active\":%d,\"routes\":%d,\"active_route\":%d,"
