+// ---- the disc as extracted files ------------------------------------------
+
+// Mode 2 Form 1 sector rebuild: the EDC and the P/Q parity of the CD-ROM
+// layer, computed as the mastering tools did (the tables of Neill Corlett's
+// ECM), so a rebuilt sector matches the disc byte for byte.
+namespace {
+
+struct EccTables {
+    uint8_t f[256];
+    uint8_t b[256];
+    uint32_t edc[256];
+    EccTables() {
+        for (uint32_t i = 0; i < 256; ++i) {
+            const uint32_t j = (i << 1) ^ ((i & 0x80u) ? 0x11Du : 0u);
+            f[i] = static_cast<uint8_t>(j);
+            b[i ^ (j & 0xFFu)] = static_cast<uint8_t>(i);
+            uint32_t e = i;
+            for (int k = 0; k < 8; ++k) e = (e >> 1) ^ ((e & 1u) ? 0xD8018001u : 0u);
+            edc[i] = e;
+        }
+    }
+};
+
+const EccTables& ecc_tables() {
+    static const EccTables tables;
+    return tables;
+}
+
+uint32_t edc_compute(const uint8_t* src, size_t size) {
+    const EccTables& t = ecc_tables();
+    uint32_t edc = 0;
+    while (size--) edc = (edc >> 8) ^ t.edc[(edc ^ *src++) & 0xFFu];
+    return edc;
+}
+
+void ecc_block(const uint8_t* src, uint32_t major_count, uint32_t minor_count,
+               uint32_t major_mult, uint32_t minor_inc, uint8_t* dest) {
+    const EccTables& t = ecc_tables();
+    const uint32_t size = major_count * minor_count;
+    for (uint32_t major = 0; major < major_count; ++major) {
+        uint32_t index = (major >> 1) * major_mult + (major & 1u);
+        uint8_t a = 0, b = 0;
+        for (uint32_t minor = 0; minor < minor_count; ++minor) {
+            const uint8_t v = src[index];
+            index += minor_inc;
+            if (index >= size) index -= size;
+            a ^= v;
+            b ^= v;
+            a = t.f[a];
+        }
+        a = t.b[t.f[a] ^ b];
+        dest[major] = a;
+        dest[major + major_count] = static_cast<uint8_t>(a ^ b);
+    }
+}
+
+// A whole Mode 2 Form 1 sector from its address, subheader and user data.
+void build_form1_sector(uint32_t lba, const uint8_t sub[4], const uint8_t* user,
+                        uint8_t* out) {
+    out[0] = 0x00;
+    std::memset(out + 1, 0xFF, 10);
+    out[11] = 0x00;
+    const uint32_t a = lba + CD_LEAD_IN_FRAMES;
+    out[12] = binary_to_bcd(a / CD_FRAMES_PER_MINUTE);
+    out[13] = binary_to_bcd((a / CD_FRAMES_PER_SECOND) % 60u);
+    out[14] = binary_to_bcd(a % CD_FRAMES_PER_SECOND);
+    out[15] = 0x02;
+    std::memcpy(out + 16, sub, 4);
+    std::memcpy(out + 20, sub, 4);
+    std::memcpy(out + 24, user, SECTOR_SIZE);
+    const uint32_t edc = edc_compute(out + 16, 8 + SECTOR_SIZE);
+    out[2072] = static_cast<uint8_t>(edc);
+    out[2073] = static_cast<uint8_t>(edc >> 8);
+    out[2074] = static_cast<uint8_t>(edc >> 16);
+    out[2075] = static_cast<uint8_t>(edc >> 24);
+    // Mode 2 parity covers the header as zeros.
+    uint8_t header[4];
+    std::memcpy(header, out + 12, 4);
+    std::memset(out + 12, 0, 4);
+    ecc_block(out + 12, 86, 24, 2, 86, out + 2076);
+    ecc_block(out + 12, 52, 43, 86, 88, out + 2076 + 172);
+    std::memcpy(out + 12, header, 4);
+}
+
+bool parse_hex(const std::string& text, uint8_t* out, size_t bytes) {
+    if (text.size() != bytes * 2) return false;
+    for (size_t i = 0; i < bytes; ++i) {
+        unsigned v = 0;
+        if (std::sscanf(text.c_str() + i * 2, "%2x", &v) != 1) return false;
+        out[i] = static_cast<uint8_t>(v);
+    }
+    return true;
+}
+
+std::string to_hex(const uint8_t* p, size_t bytes) {
+    static const char digits[] = "0123456789abcdef";
+    std::string s;
+    for (size_t i = 0; i < bytes; ++i) {
+        s += digits[p[i] >> 4];
+        s += digits[p[i] & 15];
+    }
+    return s;
+}
+
+constexpr const char* kFolderSystemName = "disc_system.bin";
+// EDC and ECC bytes of data sectors that do not match their data (a dump's
+// misread sectors): kept as on the disc so the sector rebuilds exactly.
+constexpr const char* kFolderEccName = "disc_ecc.bin";
+constexpr size_t kEccOffset = 2072;
+constexpr size_t kEccBytes = RAW_SECTOR_SIZE - kEccOffset;
+
+} // namespace
+
+struct FolderExtent {
+    enum Kind { Plain, Raw, System };
+    uint32_t lba = 0;
+    uint32_t sectors = 0;
+    Kind kind = Raw;
+    uint32_t size = 0;                 // Plain: file bytes
+    uint8_t sub[4] = {};               // Plain: subheader of its sectors...
+    std::vector<std::pair<uint32_t, std::array<uint8_t, 4>>> sub_except;  // ...but these
+    std::vector<std::pair<uint32_t, uint32_t>> ecc_except;  // sector -> disc_ecc.bin record
+    std::string path;                  // Plain/Raw: relative to the folder
+    uint32_t first = 0;                // System: first sector in disc_system.bin
+    std::vector<uint8_t> data;         // Plain: loaded on first read
+    std::unique_ptr<std::ifstream> file;  // Raw/System: opened on first read
+};
+
+struct FolderDiscState {
+    std::filesystem::path dir;
+    uint32_t sector_count = 0;
+    std::vector<FolderExtent> extents;  // sorted by lba, disjoint
+    std::vector<uint8_t> ecc;           // disc_ecc.bin
+};
+
+static FolderExtent* folder_extent_for(FolderDiscState& f, uint32_t lba) {
+    auto it = std::upper_bound(
+        f.extents.begin(), f.extents.end(), lba,
+        [](uint32_t l, const FolderExtent& e) { return l < e.lba; });
+    if (it == f.extents.begin()) return nullptr;
+    --it;
+    return lba - it->lba < it->sectors ? &*it : nullptr;
+}
+
+static bool folder_read_raw(FolderDiscState& f, uint32_t lba, uint8_t* out) {
+    if (lba >= f.sector_count) return false;
+    FolderExtent* e = folder_extent_for(f, lba);
+    if (!e) {
+        std::memset(out, 0, RAW_SECTOR_SIZE);
+        return true;
+    }
+    const uint32_t index = lba - e->lba;
+    if (e->kind == FolderExtent::Plain) {
+        if (e->data.empty() && e->size) {
+            std::ifstream in(f.dir / e->path, std::ios::binary);
+            std::vector<uint8_t> bytes(e->size);
+            in.read(reinterpret_cast<char*>(bytes.data()), e->size);
+            if (in.gcount() != static_cast<std::streamsize>(e->size)) return false;
+            e->data = std::move(bytes);
+        }
+        uint8_t user[SECTOR_SIZE] = {};
+        const uint64_t off = static_cast<uint64_t>(index) * SECTOR_SIZE;
+        if (off < e->size)
+            std::memcpy(user, e->data.data() + off,
+                        std::min<uint64_t>(SECTOR_SIZE, e->size - off));
+        const uint8_t* sub = e->sub;
+        for (const auto& x : e->sub_except)
+            if (x.first == index) { sub = x.second.data(); break; }
+        build_form1_sector(lba, sub, user, out);
+        for (const auto& x : e->ecc_except) {
+            if (x.first != index) continue;
+            const size_t off = static_cast<size_t>(x.second) * kEccBytes;
+            if (off + kEccBytes > f.ecc.size()) return false;
+            std::memcpy(out + kEccOffset, f.ecc.data() + off, kEccBytes);
+            break;
+        }
+        return true;
+    }
+    if (!e->file) {
+        e->file = std::make_unique<std::ifstream>(
+            f.dir / (e->kind == FolderExtent::System ? std::string(kFolderSystemName) : e->path),
+            std::ios::binary);
+        if (!e->file->is_open()) { e->file.reset(); return false; }
+    }
+    const uint64_t sector = (e->kind == FolderExtent::System ? e->first : 0u) + index;
+    e->file->clear();
+    e->file->seekg(static_cast<std::streamoff>(sector * RAW_SECTOR_SIZE), std::ios::beg);
+    e->file->read(reinterpret_cast<char*>(out), RAW_SECTOR_SIZE);
+    const bool ok = e->file->gcount() == static_cast<std::streamsize>(RAW_SECTOR_SIZE);
+    e->file->clear();
+    return ok;
+}
