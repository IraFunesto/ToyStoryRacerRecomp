+    if (num_words) {
+        /* A drawing chain never starts a packet with a VRAM->CPU read
+         * (GP0 C0h-DFh) or an undefined opcode: such a node is corrupt game
+         * data (Toy Story Racer's Pier sea grid, one block of which the game
+         * relocates wrongly, builds quads whose command byte is a colour
+         * overflow). Skip the whole node, keeping the chain, instead of
+         * letting the GPU parse its coordinates as commands. */
+        uint32_t op = psx_read_word(addr + 4u) >> 24;
+        if ((op >= 0xC0u && op <= 0xDFu) || (op >= 0x03u && op <= 0x1Eu) ||
+            op == 0xE0u || op >= 0xE7u) {
+            static unsigned warned;
+            if (warned++ < 8)
+                fprintf(stderr, "dma: skipped corrupt GPU packet at 0x%08X (%u words, opcode 0x%02X)\n",
+                        addr, num_words, op);
+            return 0;
+        }
+    }
     return 1;
