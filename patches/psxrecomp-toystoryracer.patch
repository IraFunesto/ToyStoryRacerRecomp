+std::filesystem::path disc_override_dir() {
+    namespace fs = std::filesystem;
+    fs::path dir;
+#ifdef _WIN32
+    wchar_t buf[MAX_PATH * 4];
+    DWORD n = GetModuleFileNameW(NULL, buf, (DWORD)(sizeof(buf) / sizeof(buf[0])));
+    if (n > 0 && n < (DWORD)(sizeof(buf) / sizeof(buf[0])))
+        dir = fs::path(std::wstring(buf, buf + n)).parent_path();
+#endif
+    if (dir.empty()) dir = fs::path(".");
+    return dir / "disc_override";
+}
+
+void load_disc_overrides(PS1::ISOReader* reader) {
+    namespace fs = std::filesystem;
+    g_disc_overrides.clear();
+    std::error_code ec;
+    const fs::path dir = disc_override_dir();
+    if (!fs::is_directory(dir, ec)) return;
+    for (fs::recursive_directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+        if (!it->is_regular_file(ec)) continue;
+        std::string rel = it->path().lexically_relative(dir).generic_string();
+        std::string disc_path = rel;
+        for (char& c : disc_path) c = (char)std::toupper((unsigned char)c);
+        PS1::ISOFileEntry entry;
+        if (!reader->FindFile(disc_path, entry) || entry.is_directory) {
+            std::fprintf(stderr, "psxrecomp: disc_override: %s is not on the disc, ignored\n",
+                         rel.c_str());
+            continue;
+        }
+        std::ifstream f(it->path(), std::ios::binary);
+        std::vector<uint8_t> data((std::istreambuf_iterator<char>(f)),
+                                  std::istreambuf_iterator<char>());
+        const uint32_t sectors = (entry.size + 2047u) / 2048u;
