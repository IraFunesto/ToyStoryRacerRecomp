-    cdrom_apply_savestate_delay_caps(/*log_clamps*/log_probe);
-    if (log_probe)
-        fprintf(stderr,
-                "cdrom: savestate boost armed for %d vblanks (delay cap %d)\n",
-                CDROM_SAVESTATE_BOOST_VBLANKS, CDROM_SAVESTATE_DELAY_CAP);
-}
