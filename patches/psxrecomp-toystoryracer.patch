+    for (const auto& t : tracks_) {
+        if (t.number == track) return t.is_audio;
+    }
+    return false;
+}
+
+RootDirectoryInfo ISOReader::GetRootDirectory() const {
+    return root_dir_;
+}
+
+uint32_t ISOReader::Read733(const uint8_t* data) const {
+    // Read little-endian half of both-endian 32-bit value
+    return data[0] | (data[1] << 8) | (data[2] << 16) | (data[3] << 24);
+}
+
+bool ISOReader::ParseVolumeDescriptor() {
+    // Read Primary Volume Descriptor from sector 16
+    uint8_t pvd[SECTOR_SIZE];
+    if (!ReadSector(PVD_SECTOR, pvd)) {
+        return false;
+    }
+
+    // Verify ISO9660 signature: offset 1 should contain "CD001"
+    if (pvd[0] != 0x01 || std::memcmp(&pvd[1], "CD001", 5) != 0) {
+        return false;  // Not a valid ISO9660 disc
+    }
+
+    // Extract volume ID (offset 40, 32 bytes, space-padded ASCII)
+    volume_id_.clear();
+    for (int i = 0; i < 32; i++) {
+        char c = pvd[40 + i];
+        if (c != ' ' && c != '\0') {
+            volume_id_ += c;
+        }
+    }
+
+    // Extract root directory record (offset 156, 34 bytes)
+    const uint8_t* root_record = &pvd[156];
+
+    // Root directory LBA is at offset 2 within the directory record (both-endian 32-bit)
+    root_dir_.lba = Read733(&root_record[2]);
+
+    // Root directory size is at offset 10 within the directory record (both-endian 32-bit)
+    root_dir_.size = Read733(&root_record[10]);
+
+    return true;
+}
+
+bool ISOReader::ParseDirectoryRecord(const uint8_t* data, ISOFileEntry& entry) const {
+    // Check record length (offset 0)
+    uint8_t record_len = data[0];
+    if (record_len == 0 || record_len < 33) {
+        return false;  // Invalid or padding record
+    }
+
+    // Extract LBA (offset 2, both-endian 32-bit)
+    entry.lba = Read733(&data[2]);
+
+    // Extract file size (offset 10, both-endian 32-bit)
+    entry.size = Read733(&data[10]);
+
+    // Extract file flags (offset 25)
+    uint8_t flags = data[25];
+    entry.is_directory = (flags & 0x02) != 0;
+
+    // Extract filename length (offset 32)
+    uint8_t name_len = data[32];
+    if (name_len == 0) {
+        return false;  // Invalid record
+    }
+
+    // Extract filename (offset 33)
+    const char* name_ptr = reinterpret_cast<const char*>(&data[33]);
+
+    // Handle special directory entries
+    if (name_len == 1 && name_ptr[0] == '\x00') {
+        entry.name = ".";  // Current directory
+        return true;
+    }
+    if (name_len == 1 && name_ptr[0] == '\x01') {
+        entry.name = "..";  // Parent directory
+        return true;
+    }
+
+    // Parse regular filename, strip version suffix (";1")
+    entry.name.clear();
+    for (uint8_t i = 0; i < name_len; i++) {
+        char c = name_ptr[i];
+        if (c == ';') {
+            break;  // Stop at version separator
+        }
+        entry.name += c;
+    }
+
+    return true;
+}
+
+std::vector<ISOFileEntry> ISOReader::ListFilesByLBA(uint32_t lba, uint32_t dir_size) {
+    std::vector<ISOFileEntry> results;
+
+    if (!is_open_ || lba == 0 || dir_size == 0) {
+        return results;
+    }
+
+    // Calculate number of sectors needed for directory data
+    uint32_t num_sectors = (dir_size + 2047) / 2048;
+
+    // Allocate buffer for directory data
+    std::vector<uint8_t> dir_data(num_sectors * 2048, 0);
+
+    // Read all directory sectors
+    for (uint32_t i = 0; i < num_sectors; i++) {
+        if (!ReadSector(lba + i, &dir_data[i * 2048])) {
+            return results;  // Error reading sector
+        }
+    }
+
+    // Parse directory records
+    uint32_t offset = 0;
+    while (offset < dir_size) {
+        uint8_t record_len = dir_data[offset];
+
+        if (record_len == 0) {
+            // Skip to next sector boundary
+            uint32_t sector_offset = offset % 2048;
+            if (sector_offset != 0) {
+                offset += (2048 - sector_offset);
+                continue;
+            }
+            break;
+        }
+
+        if (offset + record_len > dir_data.size()) break;
+
+        ISOFileEntry entry;
+        if (ParseDirectoryRecord(&dir_data[offset], entry)) {
+            if (entry.name != "." && entry.name != "..") {
+                results.push_back(entry);
+            }
+        }
+
+        offset += record_len;
+    }
+
+    return results;
+}
+
+std::vector<ISOFileEntry> ISOReader::ListFiles(const std::string& path) {
+    std::vector<ISOFileEntry> results;
+
+    // Check if file is open
+    if (!is_open_) {
+        return results;
+    }
+
+    if (path.empty()) {
+        // List root directory
+        RootDirectoryInfo root = GetRootDirectory();
+        return ListFilesByLBA(root.lba, root.size);
+    }
+
+    // Non-empty path: navigate to that subdirectory within the root
+    // Find the matching directory entry in root
+    RootDirectoryInfo root = GetRootDirectory();
+    std::vector<ISOFileEntry> root_entries = ListFilesByLBA(root.lba, root.size);
+
+    std::string path_upper = path;
+    std::transform(path_upper.begin(), path_upper.end(), path_upper.begin(),
+                   [](unsigned char c) { return std::toupper(c); });
+
+    for (const auto& e : root_entries) {
+        if (!e.is_directory) continue;
+        std::string name_upper = e.name;
+        std::transform(name_upper.begin(), name_upper.end(), name_upper.begin(),
+                       [](unsigned char c) { return std::toupper(c); });
+        if (name_upper == path_upper) {
+            // Found the subdirectory — list its contents
+            return ListFilesByLBA(e.lba, e.size > 0 ? e.size : 2048);
+        }
+    }
+
+    return results;  // Directory not found
+}
+
+bool ISOReader::FindFile(const std::string& path, ISOFileEntry& entry) {
+    // Check if file is open
+    if (!is_open_) {
+        return false;
+    }
+
+    // Check if path contains a directory separator
+    size_t sep = path.find('/');
+    if (sep == std::string::npos) {
+        sep = path.find('\\');
+    }
+
+    if (sep != std::string::npos) {
+        // Subdirectory path: "DIR/FILE" or "DIR\FILE"
+        std::string dir_name  = path.substr(0, sep);
+        std::string file_name = path.substr(sep + 1);
+
+        // List the subdirectory
+        std::vector<ISOFileEntry> sub_files = ListFiles(dir_name);
+
+        std::string file_upper = file_name;
+        std::transform(file_upper.begin(), file_upper.end(), file_upper.begin(),
+                       [](unsigned char c) { return std::toupper(c); });
+
+        for (const auto& f : sub_files) {
+            std::string name_upper = f.name;
+            std::transform(name_upper.begin(), name_upper.end(), name_upper.begin(),
+                           [](unsigned char c) { return std::toupper(c); });
+            if (name_upper == file_upper) {
+                entry = f;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // Root-level file: search root directory
+    std::vector<ISOFileEntry> files = ListFiles("");
+
+    // Search for matching filename (case-insensitive comparison)
+    for (const auto& file : files) {
+        std::string file_upper = file.name;
+        std::string path_upper = path;
+
+        std::transform(file_upper.begin(), file_upper.end(), file_upper.begin(),
+                       [](unsigned char c) { return std::toupper(c); });
+        std::transform(path_upper.begin(), path_upper.end(), path_upper.begin(),
+                       [](unsigned char c) { return std::toupper(c); });
+
+        if (file_upper == path_upper) {
+            entry = file;
+            return true;
+        }
+    }
+
+    // File not found
+    return false;
+}
+
+size_t ISOReader::ReadFile(const std::string& path, uint8_t* buffer, size_t max_size) {
+    // Validate buffer pointer
+    if (!buffer) {
+        return 0;
+    }
+
+    // Find the file
+    ISOFileEntry entry;
+    if (!FindFile(path, entry)) {
+        return 0;  // File not found
+    }
+
+    // Calculate how many bytes to read (min of file size and max_size)
+    size_t bytes_to_read = std::min(static_cast<size_t>(entry.size), max_size);
+
+    // Calculate number of sectors to read
+    uint32_t sectors_to_read = (bytes_to_read + SECTOR_SIZE - 1) / SECTOR_SIZE;
+
+    // Read sectors sequentially
+    size_t bytes_read = 0;
+    for (uint32_t i = 0; i < sectors_to_read; i++) {
+        // Calculate how many bytes to read from this sector
+        size_t bytes_remaining = bytes_to_read - bytes_read;
+        size_t sector_bytes = std::min(bytes_remaining, SECTOR_SIZE);
+
+        // Read sector into temporary buffer
+        uint8_t sector_buffer[SECTOR_SIZE];
+        if (!ReadSector(entry.lba + i, sector_buffer)) {
+            return bytes_read;  // Error - return what we've read so far
+        }
+
+        // Copy data to output buffer
+        std::memcpy(buffer + bytes_read, sector_buffer, sector_bytes);
+        bytes_read += sector_bytes;
+    }
+
+    return bytes_read;
+}
+
+size_t ISOReader::GetFileSize(const std::string& path) {
+    // Find the file
+    ISOFileEntry entry;
+    if (!FindFile(path, entry)) {
+        return 0;  // File not found
+    }
+
+    // Return file size
+    return entry.size;
+}
+
+bool ISOReader::ExtractToFolder(const std::string& image, const std::string& folder,
+                                std::string* message) {
+    namespace fs = std::filesystem;
+    auto fail = [&](const std::string& why) {
+        if (message) *message = why;
+        return false;
+    };
+    ISOReader src;
+    if (!src.Open(image)) return fail("cannot open " + image);
+    if (src.folder_) return fail("the image is already an extracted folder");
+    uint8_t raw[RAW_SECTOR_SIZE];
+    if (!src.ReadRawSector(PVD_SECTOR, raw)) return fail("not a raw (2352-byte sector) image");
+    const uint32_t total = src.GetSectorCount();
+    if (!total || !src.root_dir_.lba) return fail("no ISO 9660 filesystem");
+
+    // Every file, in disc order.
+    struct File { std::string path; uint32_t lba; uint32_t size; uint32_t sectors; };
+    std::vector<File> files;
+    struct Dir { uint32_t lba; uint32_t size; std::string prefix; int depth; };
+    std::vector<Dir> stack{{src.root_dir_.lba, src.root_dir_.size, "", 0}};
+    while (!stack.empty()) {
+        const Dir d = stack.back();
+        stack.pop_back();
+        if (d.depth > 8) return fail("directory tree too deep");
+        for (const ISOFileEntry& e : src.ListFilesByLBA(d.lba, d.size)) {
+            if (e.name.empty() || e.name.find("..") != std::string::npos ||
+                e.name.find_first_of("/\\:") != std::string::npos)
+                return fail("unexpected file name on the disc");
+            if (e.is_directory) {
+                stack.push_back({e.lba, e.size ? e.size : 2048u, d.prefix + e.name + "/",
+                                 d.depth + 1});
+            } else {
+                const uint32_t n = std::max<uint32_t>(1u, (e.size + 2047u) / 2048u);
+                files.push_back({d.prefix + e.name, e.lba, e.size, n});
+            }
+        }
+    }
+    std::sort(files.begin(), files.end(),
+              [](const File& a, const File& b) { return a.lba < b.lba; });
+    for (size_t i = 0; i < files.size(); ++i) {
+        if (files[i].lba + files[i].sectors > total ||
+            (i && files[i - 1].lba + files[i - 1].sectors > files[i].lba))
+            return fail("files overlap or run past the end of the disc: " + files[i].path);
+    }
+
+    const fs::path dir(folder);
+    std::error_code ec;
+    fs::create_directories(dir, ec);
+    fs::remove(dir / kFolderLayoutName, ec);   // never mount a half-made folder
+    const fs::path check = dir / "verify.psxdisc";
+
+    std::string layout = "psxdisc 1\n";
+    layout += "# the disc as extracted files: plain = Mode 2 Form 1 data file (sectors\n"
+              "# rebuilt with header, subheader, EDC, ECC), raw = 2352-byte sectors,\n"
+              "# system = sectors no file owns, raw in disc_system.bin\n";
+    layout += "sectors " + std::to_string(total) + "\n";
+    for (const CDTrack& t : src.tracks_)
+        layout += "track " + std::to_string(t.number) + " " + (t.is_audio ? "1 " : "0 ") +
+                  std::to_string(t.start_lba) + " " + std::to_string(t.pregap_lba) + "\n";
+    for (const auto& q : src.subq_replacements_)
+        layout += "subq " + std::to_string(q.first) + " " + to_hex(q.second.data(), 12) + "\n";
+
+    std::vector<uint8_t> owned(total, 0);
+    std::vector<uint8_t> ecc_records;
+    uint32_t plain_count = 0, raw_count = 0;
+    uint64_t bytes_out = 0;
+    std::vector<uint8_t> sectors, user;
+    uint8_t rebuilt[RAW_SECTOR_SIZE];
+    for (const File& f : files) {
+        sectors.resize(static_cast<size_t>(f.sectors) * RAW_SECTOR_SIZE);
+        for (uint32_t i = 0; i < f.sectors; ++i)
+            if (!src.ReadRawSector(f.lba + i, &sectors[static_cast<size_t>(i) * RAW_SECTOR_SIZE]))
+                return fail("read error at LBA " + std::to_string(f.lba + i));
+        // Plain when every sector is Mode 2 Form 1 and rebuilds exactly from
+        // its subheader and the file's bytes (zero past the end of the file).
+        bool plain = f.size > 0;
+        const uint8_t* sub = &sectors[16];
+        std::string except, ecc_except;
+        int except_count = 0, ecc_count = 0;
+        const size_t ecc_mark = ecc_records.size();
+        user.clear();
+        for (uint32_t i = 0; i < f.sectors && plain; ++i) {
+            const uint8_t* r = &sectors[static_cast<size_t>(i) * RAW_SECTOR_SIZE];
+            if (r[15] != 2 || (r[18] & 0x20u) || std::memcmp(r + 16, r + 20, 4) != 0) {
+                plain = false;
+                break;
+            }
+            if (std::memcmp(r + 16, sub, 4) != 0) {
+                if (++except_count > 64) { plain = false; break; }
+                except += (except.empty() ? "" : ",") + std::to_string(i) + ":" +
+                          to_hex(r + 16, 4);
+            }
+            const uint64_t off = static_cast<uint64_t>(i) * SECTOR_SIZE;
+            const size_t keep = static_cast<size_t>(
+                std::min<uint64_t>(SECTOR_SIZE, f.size > off ? f.size - off : 0));
+            uint8_t data[SECTOR_SIZE] = {};
+            std::memcpy(data, r + RAW_DATA_OFFSET, keep);
+            build_form1_sector(f.lba + i, r + 16, data, rebuilt);
+            if (std::memcmp(rebuilt, r, kEccOffset) != 0) {
+                plain = false;
+                break;
+            }
+            if (std::memcmp(rebuilt + kEccOffset, r + kEccOffset, kEccBytes) != 0) {
+                // a misread sector: its data does not match its EDC/ECC
+                if (++ecc_count > 256) { plain = false; break; }
+                ecc_except += (ecc_except.empty() ? "" : ",") + std::to_string(i) + ":" +
+                              std::to_string(ecc_records.size() / kEccBytes);
+                ecc_records.insert(ecc_records.end(), r + kEccOffset, r + RAW_SECTOR_SIZE);
+            }
+            user.insert(user.end(), data, data + keep);
+        }
+        const fs::path dest = dir / fs::path(f.path);
+        fs::create_directories(dest.parent_path(), ec);
+        std::ofstream out(dest, std::ios::binary | std::ios::trunc);
+        if (plain) {
+            out.write(reinterpret_cast<const char*>(user.data()),
+                      static_cast<std::streamsize>(user.size()));
+            layout += "plain " + std::to_string(f.lba) + " " + std::to_string(f.sectors) + " " +
+                      std::to_string(f.size) + " " + to_hex(sub, 4) + " " +
+                      (except.empty() ? std::string("-") : except) + " " +
+                      (ecc_except.empty() ? std::string("-") : ecc_except) + " " + f.path + "\n";
+            ++plain_count;
+            bytes_out += user.size();
+        } else {
+            ecc_records.resize(ecc_mark);   // this file keeps its own sectors
+            out.write(reinterpret_cast<const char*>(sectors.data()),
+                      static_cast<std::streamsize>(sectors.size()));
+            layout += "raw " + std::to_string(f.lba) + " " + std::to_string(f.sectors) + " " +
+                      f.path + "\n";
+            ++raw_count;
+            bytes_out += sectors.size();
+        }
+        out.close();
+        if (!out) return fail("cannot write " + dest.string());
+        std::fill(owned.begin() + f.lba, owned.begin() + f.lba + f.sectors, 1);
+    }
+
+    // The sectors no file owns: system area, volume descriptors, path
+    // tables, directories, gaps and the run-out after the last file.
+    std::ofstream sys(dir / kFolderSystemName, std::ios::binary | std::ios::trunc);
+    uint32_t sys_index = 0;
+    for (uint32_t lba = 0; lba < total;) {
+        if (owned[lba]) { ++lba; continue; }
+        const uint32_t start = lba, first = sys_index;
+        for (; lba < total && !owned[lba]; ++lba, ++sys_index) {
+            if (!src.ReadRawSector(lba, raw))
+                return fail("read error at LBA " + std::to_string(lba));
+            sys.write(reinterpret_cast<const char*>(raw), RAW_SECTOR_SIZE);
+        }
+        layout += "system " + std::to_string(start) + " " + std::to_string(lba - start) + " " +
+                  std::to_string(first) + "\n";
+    }
+    sys.close();
+    if (!sys) return fail("cannot write " + (dir / kFolderSystemName).string());
+    bytes_out += static_cast<uint64_t>(sys_index) * RAW_SECTOR_SIZE;
+    fs::remove(dir / kFolderEccName, ec);
+    if (!ecc_records.empty()) {
+        std::ofstream eo(dir / kFolderEccName, std::ios::binary | std::ios::trunc);
+        eo.write(reinterpret_cast<const char*>(ecc_records.data()),
+                 static_cast<std::streamsize>(ecc_records.size()));
+        eo.close();
+        if (!eo) return fail("cannot write " + (dir / kFolderEccName).string());
+    }
+    {
+        std::ofstream lay(check, std::ios::binary | std::ios::trunc);
+        lay << layout;
+        lay.close();
+        if (!lay) return fail("cannot write " + check.string());
+    }
+
+    // Mount the folder and compare every sector with the image.
+    ISOReader dst;
+    if (!dst.Open(check.string()) || dst.GetSectorCount() != total ||
+        dst.TrackCount() != src.TrackCount())
+        return fail("the extracted folder does not mount");
+    uint8_t mine[RAW_SECTOR_SIZE];
+    for (uint32_t lba = 0; lba < total; ++lba) {
+        if (!src.ReadRawSector(lba, raw) || !dst.ReadRawSector(lba, mine) ||
+            std::memcmp(raw, mine, RAW_SECTOR_SIZE) != 0)
+            return fail("sector " + std::to_string(lba) + " differs after extraction");
+    }
+    dst.Close();
+    fs::rename(check, dir / kFolderLayoutName, ec);
+    if (ec) return fail("cannot finish " + (dir / kFolderLayoutName).string());
+    if (message) {
+        char line[200];
+        std::snprintf(line, sizeof line,
+                      "%u files (%u data, %u raw streams), %u filesystem sectors, "
+                      "%u sectors with their own EDC/ECC, %.1f MiB; all %u sectors verified",
+                      plain_count + raw_count, plain_count, raw_count, sys_index,
+                      static_cast<unsigned>(ecc_records.size() / kEccBytes),
+                      bytes_out / 1048576.0, total);
+        *message = line;
+    }
+    return true;
+}
+
