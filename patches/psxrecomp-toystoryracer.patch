+bool ISOReader::OpenFolder(const std::string& layout) {
+    std::ifstream in(layout);
+    if (!in.is_open()) return false;
+    auto state = std::make_unique<FolderDiscState>();
+    state->dir = std::filesystem::path(layout).parent_path();
+    std::string line;
+    bool header = false;
+    while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (line.empty() || line[0] == '#') continue;
+        char kind[16] = {};
+        if (std::sscanf(line.c_str(), "%15s", kind) != 1) continue;
+        const std::string k = kind;
+        if (k == "psxdisc") {
+            unsigned version = 0;
+            if (std::sscanf(line.c_str(), "psxdisc %u", &version) != 1 || version != 1)
+                return false;
+            header = true;
+        } else if (k == "sectors") {
+            unsigned n = 0;
+            if (std::sscanf(line.c_str(), "sectors %u", &n) != 1) return false;
+            state->sector_count = n;
+        } else if (k == "track") {
+            unsigned number = 0, audio = 0, start = 0, pregap = 0;
+            if (std::sscanf(line.c_str(), "track %u %u %u %u",
+                            &number, &audio, &start, &pregap) != 4)
+                return false;
+            CDTrack t;
+            t.number = static_cast<int>(number);
+            t.is_audio = audio != 0;
+            t.start_lba = start;
+            t.pregap_lba = pregap;
+            tracks_.push_back(t);
+        } else if (k == "subq") {
+            unsigned lba = 0;
+            char hex[64] = {};
+            std::array<uint8_t, 12> q = {};
+            if (std::sscanf(line.c_str(), "subq %u %63s", &lba, hex) != 2 ||
+                !parse_hex(hex, q.data(), q.size()))
+                return false;
+            subq_replacements_[lba] = q;
+        } else if (k == "system") {
+            FolderExtent e;
+            e.kind = FolderExtent::System;
+            if (std::sscanf(line.c_str(), "system %u %u %u",
+                            &e.lba, &e.sectors, &e.first) != 3)
+                return false;
+            state->extents.push_back(std::move(e));
+        } else if (k == "raw") {
+            FolderExtent e;
+            e.kind = FolderExtent::Raw;
+            int used = 0;
+            if (std::sscanf(line.c_str(), "raw %u %u %n", &e.lba, &e.sectors, &used) != 2 ||
+                !used)
+                return false;
+            e.path = line.substr(static_cast<size_t>(used));
+            state->extents.push_back(std::move(e));
+        } else if (k == "plain") {
+            FolderExtent e;
+            e.kind = FolderExtent::Plain;
+            char sub[16] = {}, except[4096] = {}, ecc[4096] = {};
+            int used = 0;
+            if (std::sscanf(line.c_str(), "plain %u %u %u %15s %4095s %4095s %n",
+                            &e.lba, &e.sectors, &e.size, sub, except, ecc, &used) != 6 ||
+                !used || !parse_hex(sub, e.sub, 4))
+                return false;
+            if (std::strcmp(ecc, "-") != 0) {
+                for (const char* p = ecc; *p;) {
+                    unsigned index = 0, record = 0;
+                    int n = 0;
+                    if (std::sscanf(p, "%u:%u%n", &index, &record, &n) != 2) return false;
+                    e.ecc_except.emplace_back(index, record);
+                    p += n;
+                    if (*p == ',') ++p;
+                }
+            }
+            if (std::strcmp(except, "-") != 0) {
+                for (const char* p = except; *p;) {
+                    unsigned index = 0;
+                    char hex[9] = {};
+                    int n = 0;
+                    std::array<uint8_t, 4> s = {};
+                    if (std::sscanf(p, "%u:%8[0-9a-fA-F]%n", &index, hex, &n) != 2 ||
+                        !parse_hex(hex, s.data(), 4))
+                        return false;
+                    e.sub_except.emplace_back(index, s);
+                    p += n;
+                    if (*p == ',') ++p;
+                }
+            }
+            e.path = line.substr(static_cast<size_t>(used));
+            state->extents.push_back(std::move(e));
+        }
+    }
+    if (!header || !state->sector_count || tracks_.empty()) return false;
+    {
+        std::ifstream ecc_in(state->dir / kFolderEccName, std::ios::binary);
+        if (ecc_in.is_open())
+            state->ecc.assign(std::istreambuf_iterator<char>(ecc_in),
+                              std::istreambuf_iterator<char>());
+    }
+    std::sort(state->extents.begin(), state->extents.end(),
+              [](const FolderExtent& a, const FolderExtent& b) { return a.lba < b.lba; });
+    for (size_t i = 0; i < state->extents.size(); ++i) {
+        const FolderExtent& e = state->extents[i];
+        if (!e.sectors || e.lba + e.sectors > state->sector_count ||
+            (i && state->extents[i - 1].lba + state->extents[i - 1].sectors > e.lba))
+            return false;
+    }
+    bin_path_ = layout;
+    disc_sector_count_ = state->sector_count;
+    folder_ = std::move(state);
+    is_open_ = true;
+    if (!ParseVolumeDescriptor()) {
+        volume_id_.clear();
+        root_dir_.lba = 0;
+        root_dir_.size = 0;
+    }
+    return true;
+}
