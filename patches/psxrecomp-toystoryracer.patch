-        break;
-
-    case 0x0B: /* Mute */
-        cd_muted = 1;
-        response_push(stat_reg);
-        set_irq(CDIRQ_ACK);
-        break;
-
-    case 0x0C: /* Demute */
-        cd_muted = 0;
-        response_push(stat_reg);
-        set_irq(CDIRQ_ACK);
-        break;
-
-    case 0x0D: /* SetFilter */
-        if (param_count >= 2) {
-            filter_file = param_fifo[0];
-            filter_channel = param_fifo[1];
