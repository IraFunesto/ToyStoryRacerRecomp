-static void clear_sector_buffer(void) {
-    for (int i = 0; i < CDROM_NUM_SECTOR_BUFFERS; i++) {
-        s_sector_ring[i].size = 0;
-        s_sector_ring[i].pos = 0;
-    }
-    s_ring_read = 0;
-    s_ring_write = 0;
-    request_reg &= (uint8_t)~CDROM_REQUEST_BFRD;
