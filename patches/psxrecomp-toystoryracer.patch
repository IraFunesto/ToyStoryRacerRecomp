-static void present_lid_open_irq_if_ready(void)
-{
-    if (!s_lid_irq_pending || irq_flag != 0)
-        return;
-    stat_reg = CDSTAT_ERROR | CDSTAT_SHELL;
-    response_clear();
-    response_push(stat_reg);
-    response_push(0x08); /* shell open */
-    set_irq(CDIRQ_ERROR);
-    fire_cdrom_irq();
-    s_lid_irq_pending = 0;
-}
